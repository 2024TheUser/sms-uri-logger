#!/bin/sh
case "${1-}" in -h|--help) printf '%s\n' 'SMS URI Logger — SMS URI logging utility' '' 'Logs incoming SMS URI handler requests to a local file.' 'Stores timestamps in UTC (hexadecimal Unix time).' '' 'Usage:' '  sms-uri-logger URI   Log an SMS URI' '  sms-uri-logger -s    Show saved log' '  sms-uri-logger -c    Clear saved log' '  sms-uri-logger -h    Show this help' '' 'Supported schemes: sms:, smsto:' '' 'Log location: ${XDG_DATA_HOME:-~/.local/share}/sms-uri-logger/SMS.txt' '' 'Note: Logged URIs may contain phone numbers and message text.';exit 0;; -s) cat "${XDG_DATA_HOME:-$HOME/.local/share}/sms-uri-logger/SMS.txt" 2>/dev/null||echo "Log is empty.";exit 0;; -c) printf 'Clear log? [y/N] ';read -r a;case "$a" in [yY]|[yY][eE][sS]) : > "${XDG_DATA_HOME:-$HOME/.local/share}/sms-uri-logger/SMS.txt" 2>/dev/null&&echo "Log cleared."||echo "Cannot clear log.";;*) echo "Cancelled.";;esac;exit 0;; -*) echo "Unknown option: $1" >&2;exit 2;; '') exit 1;; sms:*|smsto:*) umask 077;mkdir -p "${XDG_DATA_HOME:-$HOME/.local/share}/sms-uri-logger"||exit 1;printf '%x\t%s\n' "$(date -u +%s)" "$(printf %s "$1"|tr '\n\r' '  ')" >> "${XDG_DATA_HOME:-$HOME/.local/share}/sms-uri-logger/SMS.txt"||exit 1;; *) echo "Unsupported URI scheme." >&2;exit 2;; esac
